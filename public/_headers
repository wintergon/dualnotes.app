# Cloudflare Pages applies these to every response. Everything the site loads is its own: no
# scripts at all, no inline styles, no third-party fonts or images — which is what lets the CSP be
# this short. A page that needs more changes this line, not the page.
/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY
